# Production environment for infra/docker-compose.prod.yml.
# Copy to infra/.env.prod on the server (chmod 600, never commit it) and replace
# every CHANGE_ME. Generate secrets with: openssl rand -hex 32
# The health profile key is NOT here: it is a secret file (docs/ops/PROFILE_KEY.md).
# Variables without the DONUT_ prefix are read by compose, Caddy or the backup job;
# DONUT_* variables are read by the app (backend/app/core/config.py).

# --- public endpoint (Product Owner: domain + DNS A/AAAA record to the VPS) ---
DONUT_API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# --- image (built by .github/workflows/backend-image.yml) ---
DONUT_IMAGE=ghcr.io/example/donut-api:CHANGE_ME_GIT_SHA

# --- app ---
DONUT_ENV=prod
DONUT_JWT_SECRET=CHANGE_ME
DONUT_IMPORT_BLOCKED_DOMAINS=["example.com"]
# Set once the bundle ID exists (RENAME_PLAN phase 3); login fails closed until then.
DONUT_APPLE_CLIENT_IDS=[]
# Id of the current health profile key in infra/secrets/donut_profile_key; change it
# with every new key (docs/ops/PROFILE_KEY.md).
DONUT_PROFILE_KEY_ID=1
# Uvicorn worker processes in the API container (2 vCPU VPS).
API_WORKERS=2

# --- postgres (internal only) ---
# DONUT_DATABASE_URL: postgresql+asyncpg URL for user POSTGRES_USER with
# POSTGRES_PASSWORD at host `postgres`, port 5432, database POSTGRES_DB.
DONUT_DATABASE_URL=CHANGE_ME
POSTGRES_USER=donut
POSTGRES_DB=donut
POSTGRES_PASSWORD=CHANGE_ME

# --- redis (internal only) ---
# DONUT_REDIS_URL: redis URL with REDIS_PASSWORD, host `redis`, port 6379, db 0.
DONUT_REDIS_URL=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- backups to Cloudflare R2 (Product Owner: R2 account, bucket, API token) ---
R2_ACCOUNT_ID=CHANGE_ME
R2_BUCKET=donut-backups
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_PREFIX=postgres
BACKUP_RETENTION_DAYS=30
# age public key; the matching private key never lives on the server (docs/ops/BACKUPS.md)
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
