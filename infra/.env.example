# Docker Compose variables for the local dev stack. Dev values only, no real secrets.
# Copy to infra/.env to override; Compose reads .env from this directory.

# Redis password (redis-server --requirepass). Used in the api service's
# DONUT_REDIS_URL, so keep it URL-safe (letters, digits, - and _).
# If you change it, change DONUT_REDIS_URL in backend/.env to match.
REDIS_PASSWORD=donut
