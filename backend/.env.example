# Backend settings (app/core/config.py, prefix FITMEAL_). Dev values only, no real secrets.
# Copy to backend/.env to override; the defaults already match infra/docker-compose.yml.

FITMEAL_ENV=dev
FITMEAL_DATABASE_URL=postgresql+asyncpg://fitmeal:fitmeal@localhost:5432/fitmeal
# Password must match REDIS_PASSWORD in infra/.env.
FITMEAL_REDIS_URL=redis://:fitmeal@localhost:6379/0

# Used by tests/conftest.py.
FITMEAL_TEST_DATABASE_URL=postgresql+asyncpg://fitmeal:fitmeal@localhost:5432/fitmeal_test
