# Backend settings (app/core/config.py, prefix DONUT_). Dev values only, no real secrets.
# Copy to backend/.env to override; the defaults already match infra/docker-compose.yml.

DONUT_ENV=dev
DONUT_DATABASE_URL=postgresql+asyncpg://donut:donut@localhost:5432/donut
# Password must match REDIS_PASSWORD in infra/.env.
DONUT_REDIS_URL=redis://:donut@localhost:6379/0

# Used by tests/conftest.py.
DONUT_TEST_DATABASE_URL=postgresql+asyncpg://donut:donut@localhost:5432/donut_test

# Health profile column key (D13), base64 of 32 bytes: openssl rand -base64 32.
# Dev only; there is no default, and without it /v1/me/profile answers 503.
# DONUT_PROFILE_KEY=
# DONUT_PROFILE_KEY_ID=1
